APP_NAME=Smart Sembako Cloud Bot
ENVIRONMENT=production
PORT=10000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY
MERCHANT_ID=merchant_smart_sembako
TENANT_ISOLATION_REQUIRED=false
STORE_TIMEZONE=Asia/Jakarta

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_SECRET_TOKEN=CHANGE_ME_RANDOM_SECRET
DESKTOP_SHARED_SECRET=CHANGE_ME_SAME_AS_DESKTOP_TELEGRAM_SECRET
OWNER_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_IDS=
CASHIER_TELEGRAM_IDS=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_MORNING_HR=7
SCHEDULER_EVENING_HR=20

# LLM Providers
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
